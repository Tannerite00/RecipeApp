# Local Supabase development.
# Copy this file to `.env.local` and Vite will load it IN PLACE OF `.env`
# (Vite loads `.env.local` with higher priority than `.env`).
#
# The values below are the defaults printed by `supabase start`. If your local
# stack uses different ports/keys, run `supabase status` and paste the
# API URL and anon key shown there.

VITE_SUPABASE_URL=http://127.0.0.1:54321
